{
    "nrf_disc_auth_slice": {
        "pipeline": "sequence",

        "pcap": "captures/nrf_disc_auth_slice_open5gs.pcapng",
        "rules": "dsl/nrf_sequence_test.dsl",

        "description": "Verification of NF Discovery authorization under slice constraints",
        "nf": "NRF",

        "traffic": {
            "sources": [
                {
                    "type": "http2",
                    "display_filter": "http2",
                    "decode_as": [
                        "tcp.port==7777,http2"
                    ]
                }
            ],
            "correlation_mode": "grouped"
        },

        "report": "reports/nrf_disc_auth_slice_report.json"
    },

    "udm_resynchronization": {
        "pipeline": "sequence",

        "pcap": "captures/udm_synch_fail_open5gs.pcapng",

        "rules": "dsl/udm_resynchronization.dsl",

        "description": "Verification of UDM AKA resynchronization",
        "nf": "UDM",

        "traffic": {
            "correlation_mode": "global",
            "sources": [
                {
                    "type": "http2",
                    "display_filter": "http2",
                    "decode_as": [
                        "tcp.port==7777,http2"
                    ]
                }
            ]
        },

        "external_bindings": {
            "subscriber": {
                "source": "scasdk/adapted/scasdk-nrf-udm/data/ue/subscriber.json",
                "fields": {
                    "key": "key",
                    "opc": "opc"
                }
            }
        },

        "derived_bindings": {
            "initial_mac": {
                "type": "udm_auth_vector_mac",
                "auth_vector": "initial_response.body.authenticationVector",
                "key": "subscriber.key",
                "opc": "subscriber.opc"
            }
        },

        "report": "reports/udm_resynchronization/report.json"
    },

    "udm_suci_deconcealment": {
        "pipeline": "sequence",

        "pcap": "captures/udm_suci_deconcealment_open5gs.pcapng",

        "rules": "dsl/udm_suci_deconcealment.dsl",

        "description": "Verification of UDM SUCI de-concealment",
        "nf": "UDM",

        "traffic": {
            "correlation_mode": "grouped",
            "sources": [
                {
                    "type": "http2",
                    "display_filter": "http2",
                    "decode_as": [
                        "tcp.port==7777,http2"
                    ]
                }
            ]
        },

        "external_bindings": {
            "expected": {
                "source": "scasdk/adapted/scasdk-nrf-udm/data/ue/subscriber.json",
                "fields": {
                    "supi": {
                        "path": "supi",
                        "prefix": "imsi-"
                    }
                }
            }
        },

        "report": "reports/udm_suci_deconcealment/report.json"
    },

    "amf_sync_failure_case_a": {
        "pipeline": "sequence",
        "case": "A",

        "pcap": "captures/free5gc-amf-TC-SYNC-FAIL-SEAF-AMF-Case_A.pcap",

        "rules": "dsl/amf_sync_failure_case_a_sequence.dsl",
        "temporal_rules": "dsl/amf_sync_failure.dsl",

        "description": "Verification of AMF synchronization failure handling - Case A",
        "nf": "AMF",

        "traffic": {
            "sources": [
                {
                    "type": "nas",
                    "display_filter": "nas_5gs.mm.message_type"
                },
                {
                    "type": "http2",
                    "display_filter": "http2",
                    "decode_as": [
                        "tcp.port==15001,http2",
                        "tcp.port==80,http2"
                    ]
                }
            ],

            "correlation_mode": "global"
        },

        "temporal": {
            "signature": "mfotl/amf_sync_failure.sig",
            "generated_formula": "mfotl/generated/amf_sync_failure_case_a.mfotl",
            "log": "mfotl/amf_sync_failure_case_a.log",

            "timer": {
                "name": "T3520",
                "duration_ms": 15000
            },

            "event_mapping": {
                "resync": "ResynchronizationRequest()",
                "new_vector": "AusfAuthenticationResponse()"
            }
        },

        "report": "reports/amf_sync_failure_case_a/report.json"
    },

    "amf_sync_failure_case_b": {
        "pipeline": "sequence",
        "case": "B",

        "pcap": "captures/free5gc-amf-TC-SYNC-FAIL-SEAF-AMF-Case B.pcap",

        "rules": "dsl/amf_sync_failure_case_b_sequence.dsl",
        "temporal_rules": "dsl/amf_sync_failure.dsl",

        "description": "Verification of AMF synchronization failure handling - Case B",
        "nf": "AMF",

        "traffic": {
            "sources": [
                {
                    "type": "nas",
                    "display_filter": "nas_5gs.mm.message_type"
                },
                {
                    "type": "http2",
                    "display_filter": "http2",
                    "decode_as": [
                        "tcp.port==15001,http2",
                        "tcp.port==80,http2"
                    ]
                }
            ],
            "correlation_mode": "global"
        },

        "temporal": {
            "signature": "mfotl/amf_sync_failure.sig",
            "generated_formula": "mfotl/generated/amf_sync_failure_case_b.mfotl",
            "log": "mfotl/amf_sync_failure_case_b.log",

            "timer": {
                "name": "T3520",
                "duration_ms": 15000
            },

            "event_mapping": {
                "sync_failure": "SyncFailure()",
                "subsequent_auth_request": "AuthenticationRequest()"
            }
        },

        "report": "reports/amf_sync_failure_case_b/report.json"
    },
         
    "upf_teid_uniqueness": {
        "pipeline": "collect",

        "pcap": "captures/upf_teid_uniqueness_open5gs.pcapng",
        "rules": "dsl/upf_teid_uniqueness.dsl",

        "description": "Verification of F-TEID uniqueness across PFCP Session Establishment Responses",
        "nf": "UPF",

        "traffic": {
            "sources": [
                {
                    "type": "pfcp",
                    "display_filter": "pfcp.msg_type == 51"
                }
            ]
        },

        "report": "reports/upf_teid_uniqueness/report.json"
    },

    "resstar_verification_failure": {
        "extractor": "extractor.resstar_verification_failure_extractor",
        "verifier": "verifier.simple_verifier",
        "reporter": "reporter.resstar_verification_failure_reporter",
        "rules": "dsl/resstar_verification_failure.dsl",

        "cases": {
            "A": {
                "identity_path": "direct_suci",
                "failure_source": "local",
                "pcap": "captures/free5gc-amf-TC_RESSTAR_VERIFICATION_FAILURE_1.pcap",
                "evidence": "reports/resstar_verification_failure/case_a/evidence.json",
                "output": "reports/resstar_verification_failure/case_a/verification.json",
                "report": "reports/resstar_verification_failure/case_a/report.json"
            },

            "B": {
                "identity_path": "guti_then_suci",
                "failure_source": "local",
                "pcap": "captures/free5gc-amf-TC_RESSTAR_VERIFICATION_FAILURE_2.pcap",
                "evidence": "reports/resstar_verification_failure/case_b/evidence.json",
                "output": "reports/resstar_verification_failure/case_b/verification.json",
                "report": "reports/resstar_verification_failure/case_b/report.json"
            },

            "C": {
                "identity_path": "direct_suci",
                "failure_source": "ausf",
                "pcap": "captures/free5gc-amf-TC_RESSTAR_VERIFICATION_FAILURE_3.pcap",
                "evidence": "reports/resstar_verification_failure/case_c/evidence.json",
                "output": "reports/resstar_verification_failure/case_c/verification.json",
                "report": "reports/resstar_verification_failure/case_c/report.json"
            },

            "D": {
                "identity_path": "guti_then_suci",
                "failure_source": "ausf",
                "pcap": "captures/free5gc-amf-TC_RESSTAR_VERIFICATION_FAILURE_4.pcap",
                "evidence": "reports/resstar_verification_failure/case_d/evidence.json",
                "output": "reports/resstar_verification_failure/case_d/verification.json",
                "report": "reports/resstar_verification_failure/case_d/report.json"
            }
        }
    }
}